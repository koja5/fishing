{
    "pageSize": 10,
    "paging": {
        "enable": true,
        "settings": {
            "pageSizes": true,
            "pageSize": 20
        }
    },
    "sorting": {
        "enable": true
    },
    "grouping": {
        "enable": true,
        "group": []
    },
    "filtering": {
        "enable": true,
        "settings": {
            "type": "Menu"
        }
    },
    "formDialog": {
        "type": "sidebar",
        "closeAfterExecute": false,
        "size": "lg"
    },
    "customGrouping": false,
    "allowResizing": true,
    "reorderable": true,
    "selectable": true,
    "scrollable": false,
    "hideable": true,
    "refresh": false,
    "reset": true,
    "editSettings": {
        "allowEditing": true,
        "allowAdding": true,
        "allowDeleting": true,
        "showDeleteConfirmDialog": true,
        "mode": "Dialog"
    },
    "editSettingsRequest": {
        "add": {
            "type": "POST",
            "api": "/api/owner/setObservationSheet",
            "parameters": [],
            "fields": "",
            "root": ""
        }
    },
    "columns": [
        {
            "title": "",
            "flexGrow": 1,
            "template": {
                "type": "action",
                "actionMode": {
                    "type": "button",
                    "icon": "eye",
                    "routerLink": {
                        "newTab": false,
                        "link": "/dashboard/admin/observation-sheet-details",
                        "parameters": [
                            "year",
                            "id_owner"
                        ]
                    }
                }
            }
        },
        {
            "title": "commonFields.year",
            "filterable": true,
            "hideable": true,
            "filter": "date",
            "type": "string",
            "class": "text-align-right",
            "field": "year",
            "validation": {
                "required": true
            }
        },
        {
            "title": "commonFields.name",
            "filterable": true,
            "hideable": true,
            "filter": "date",
            "type": "string",
            "class": "text-align-right",
            "field": "owner_name",
            "validation": {
                "required": true
            }
        },
        {
            "title": "commonFields.status",
            "field": "status",
            "template": {
                "choices": [
                    {
                        "field": "status",
                        "value": 0,
                        "operator": "==",
                        "apart": {
                            "title": "status.empty",
                            "badge": "badge badge-pill badge-light-default"
                        }
                    },
                    {
                        "field": "status",
                        "value": 1,
                        "operator": "==",
                        "apart": {
                            "title": "status.default",
                            "badge": "badge badge-pill badge-light-warning"
                        }
                    },
                    {
                        "field": "status",
                        "value": 2,
                        "operator": "==",
                        "apart": {
                            "title": "status.completed",
                            "badge": "badge badge-pill badge-light-success"
                        }
                    }
                ]
            }
        },
        {
            "title": "commonFields.content",
            "field": "empty",
            "template": {
                "choices": [
                    {
                        "field": "empty",
                        "value": 0,
                        "operator": "==",
                        "apart": {
                            "title": "status.haveEntry",
                            "badge": "badge badge-pill badge-light-primary"
                        }
                    },
                    {
                        "field": "empty",
                        "value": 1,
                        "operator": "==",
                        "apart": {
                            "title": "status.noEntry",
                            "badge": "badge badge-pill badge-light-warning"
                        }
                    }
                ]
            }
        }
    ],
    "config": []
}